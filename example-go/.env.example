APP_ENV=development
APP_NAME="Example Rabbit MQ"
APP_VERSION=1.0.0
APP_URL=http://localhost:8090

HTTP_PORT=8090

RABBITMQ_BROKER_URI=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=hello

LOG_LEVEL=debug
LOG_FILE=/app/logs/app.log # kalo mau diganti, di compose.yaml juga perlu diganti
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=28

DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_MINUTES=5

# Minimum 32 characters.
JWT_SECRET=
JWT_TTL_MINUTES=30

# Leave empty to skip issuer (iss) validation.
JWT_ISSUER=

STORAGE_DRIVER=local
STORAGE_S3_BUCKET_URL=
STORAGE_SIGNING_KEY=
STORAGE_REQUIRE_SIGNATURE=false

